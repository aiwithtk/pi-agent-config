#!/usr/bin/env node
// brain — MongoDB-backed long-term memory for the pi agent.
//
//   brain init                      crée collections, validateurs et index (idempotent)
//   brain digest                    contexte compact à injecter au démarrage d'une session
//   brain put facts '{"key":"langue","value":"fr"}'
//   brain add journal '{"kind":"note","text":"..."}'
//   brain search "atlas stream processing" [--limit 8] [--collection facts]
//   brain ls tasks --filter '{"status":"doing"}' --limit 20
//   brain done <taskId>
//   brain rm <collection> <id>
//   brain stats | schema
//
// URI: --uri > $BRAIN_URI > $MDB_MCP_CONNECTION_STRING > Trousseau macOS > mcp.json
import { createRequire } from 'node:module';
import { execFileSync } from 'node:child_process';
import { readFileSync, existsSync, readdirSync, statSync } from 'node:fs';
import { homedir } from 'node:os';
import { join, basename, relative } from 'node:path';

const require = createRequire(import.meta.url);
function loadDriver() {
  // emplacement stable (indépendant du cache npx, qui peut être purgé)
  try { return require(join(homedir(), '.pi', 'agent', 'lib', 'node_modules', 'mongodb')); } catch {}
  const root = join(homedir(), '.npm', '_npx');
  if (existsSync(root)) {
    for (const d of readdirSync(root)) {
      try { return require(join(root, d, 'node_modules', 'mongodb')); } catch {}
    }
  }
  try { return require('mongodb'); } catch {}
  console.error('mongodb driver introuvable. Installer : cd ~/.pi/agent/lib && npm install mongodb');
  process.exit(2);
}
const { MongoClient, ObjectId } = loadDriver();

const HOME = homedir();
const MCP_JSON = join(HOME, '.pi', 'agent', 'mcp.json');
const KEYCHAIN_SERVICE = 'pi-mongodb-atlas';

// ---------------------------------------------------------------- schema
const str = (description) => ({ bsonType: 'string', ...(description ? { description } : {}) });
const arr = (description) => ({ bsonType: 'array', items: { bsonType: 'string' }, ...(description ? { description } : {}) });
const ts = { bsonType: 'date' };
const text = (weights) => ({
  keys: Object.fromEntries(Object.keys(weights).map((f) => [f, 'text'])),
  options: { name: 'text_search', default_language: 'none', weights },
});

